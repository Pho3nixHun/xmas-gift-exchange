NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:4200
APP_CONFIG_FILE=config/app.example.json
GUIDELINES_DIRECTORY=docs/content
WORKBENCH_ENABLED=true
ORGANISER_HASH_FILE=secrets/organiser.hash
ORGANISER_HASH_PATH=./secrets/organiser.hash
# Explicitly allow local HTTP Docker testing. Use false and HTTPS on your server.
ALLOW_HTTP_COOKIES=true
APP_CONFIG_PATH=./config/app.example.json
# Optional public music files served at /media/ in Docker.
MEDIA_PATH=./media
PREVIEWS_ENABLED=false
TRUST_PROXY=
MAINTENANCE=false
LOG_LEVEL=info
PARTICIPANT_SESSION_DAYS=120
ORGANISER_SESSION_HOURS=8
RECOVERY_MINUTES=30
REAUTH_MINUTES=5
DB_POOL_SIZE=10
DB_QUERY_TIMEOUT_MS=5000
REQUEST_BODY_BYTES=131072
# Local development only. Replace before running on your server.
POSTGRES_DB=winter_house
POSTGRES_USER=winter_house
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://winter_house:local-development-only@127.0.0.1:54329/winter_house
# DATABASE_URL_FILE=/run/secrets/database_url
# HOST_PORT=8080
# HOST_BIND=127.0.0.1
DOCKER_DATABASE_URL=postgresql://winter_house:local-development-only@db:5432/winter_house
